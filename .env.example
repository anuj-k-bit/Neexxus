# ==============================================================================
# NEXUS-RAG: Environment Configuration Template
# Copy this file to .env and populate with your API credentials.
# ==============================================================================

# --- LLM REASONING ENGINE (GROQ) ---
# Primary Groq API key for Planner and Responder nodes (Llama 3.3 70B)
GROQ_API_KEY=""
# Secondary Groq API key for Portkey fallback target (Llama 3.1 8B)
GROQ_FALLBACK_API_KEY=""

# --- LLM GATEWAY (PORTKEY) ---
# Portkey API key for unified routing, retry, semantic caching & tracing
PORTKEY_API_KEY=""

# --- VECTOR DATABASE (QDRANT CLOUD) ---
# Qdrant Cloud cluster endpoint (e.g., https://your-cluster-id.cloud.qdrant.io:6333)
QDRANT_CLUSTER_ENDPOINT=""
# Qdrant Cloud API access key
QDRANT_API_KEY=""

# --- EMBEDDINGS (GOOGLE GEMINI) ---
# Google Gemini API key for gemini-embedding-2-preview (3072 dimensions)
GEMINI_API_KEY=""

# --- OBSERVABILITY & TRACING ---
# Pydantic Logfire token for distributed tracing across API & retrieval spans
LOGFIRE_TOKEN=""

# LangSmith tracing for LangGraph state machine & node executions
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="nexus-rag-prod"

# --- APPLICATION INTERFACE ---
# URL for the Streamlit UI to reach the FastAPI backend
BACKEND_URL="http://localhost:8000"

# --- EVALUATION (RAGAS & GUARDRAILS) ---
# Dedicated Groq key for Judge LLM (keeps eval workloads separate from live app)
JUDGE_GROQ=""







